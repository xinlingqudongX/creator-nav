---
interface Props {
  footerLinks: { label: string; href: string }[];
  footerText: string;
}

const { footerLinks, footerText } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <nav class="site-footer__nav" aria-label="页脚">
      {footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <p>{footerText}</p>
  </div>
</footer>
