---
import Layout from '../layouts/Layout.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { getVideos } from '../lib/videos';

// 首页"热门"（PRD §4.1）：1 千 ≤ 收藏 < 1 万 的高收藏池，按收藏数降序
// ≥ 1 万的走 /1w /2w /3w /5w 档位页；SSR 30 张首屏 + 页面内预载至 200 条，滚动时本地渲染，0 次 API（§23.2）
const videos = await getVideos({ minCollects: 1_000, maxCollects: 10_000, order: 'collects', limit: 200 });

const title = '热门短视频 - Hot Video';
const description =
  '发现 1 千至 1 万收藏区间的热门短视频，按收藏数从高到低排序，持续更新。点击跳转原平台观看。';
---

<Layout title={title} description={description} path="/">
  <div class="page-head">
    <h1>热门短视频</h1>
    <p>1 千 – 1 万收藏的高收藏视频 · 按收藏数从高到低 · 共 {videos.length} 个</p>
  </div>
  <VideoGrid videos={videos} initial={30} emptyText="还没有视频，去后台导入一些收藏吧～" />
</Layout>
