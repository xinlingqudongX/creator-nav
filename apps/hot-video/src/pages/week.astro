---
import Layout from '../layouts/Layout.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { getVideos, daysAgoSec } from '../lib/videos';

// 本周热门（PRD §6.2）：publish_time 在最近 7 天内，按收藏数降序
const videos = await getVideos({ after: daysAgoSec(7), order: 'collects', limit: 200 });

const title = '本周热门短视频 - Hot Video';
const description = '本周最值得收藏的短视频合集，按收藏数排序。发现近期爆款，点击跳转原平台观看。';
---

<Layout title={title} description={description} path="/week">
  <div class="page-head">
    <h1>本周热门短视频</h1>
    <p>最近 7 天发布的高收藏视频 · 共 {videos.length} 个</p>
  </div>
  <VideoGrid videos={videos} emptyText="本周还没有新视频，看看其他档位吧～" />
</Layout>
