---
import Layout from '../../../layouts/Layout.astro';
import VideoGrid from '../../../components/VideoGrid.astro';
import { getVideos } from '../../../lib/videos';

// 月度聚合页（PRD §6.4）：/2026/08
const yearParam = Astro.params.year ?? '';
const monthParam = Astro.params.month ?? '';
const year = Number(yearParam);
const month = Number(monthParam);
const valid = /^\d{4}$/.test(yearParam) && /^\d{1,2}$/.test(monthParam) && month >= 1 && month <= 12;

if (!valid) Astro.response.status = 404;

const yearMonth = valid ? `${year}-${String(month).padStart(2, '0')}` : '';
const videos = valid ? await getVideos({ yearMonth, order: 'collects', limit: 200 }) : [];

const title = valid ? `${year}年${month}月热门短视频 - Hot Video` : '页面不存在 - Hot Video';
const description = valid
  ? `收录 ${year}年${month}月 发布的高收藏短视频，按收藏数排序。点击跳转原平台观看。`
  : '页面不存在';
---

{
  valid ? (
    <Layout title={title} description={description} path={`/${year}/${month}`}>
      <div class="page-head">
        <h1>{year}年{month}月热门短视频</h1>
        <p>共 {videos.length} 个视频</p>
      </div>
      <VideoGrid videos={videos} emptyText={`${year}年${month}月暂无视频`} />
    </Layout>
  ) : (
    <Layout title={title} description={description}>
      <div class="empty">页面不存在</div>
    </Layout>
  )
}
