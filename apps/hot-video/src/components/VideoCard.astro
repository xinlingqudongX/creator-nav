---
import type { Video } from '../lib/types';
import { formatCount } from '../lib/format';

interface Props {
  video: Video;
}

const { video } = Astro.props;
const collects = formatCount(video.collects ?? 0);
const likes = formatCount(video.likes ?? 0);
const href = `/video/${video.id}`;
---

<a class="video-card" href={href} title={video.title ?? '视频'}>
  <div class="video-card__cover">
    {
      video.cover_url ? (
        <img
          src={video.cover_url}
          alt={video.title ?? '视频封面'}
          loading="lazy"
          decoding="async"
          width="300"
          height="400"
        />
      ) : (
        <div class="video-card__cover-fallback" aria-hidden="true" />
      )
    }
    <span class="video-card__collects">⭐ {collects}</span>
    <span class="video-card__likes">❤️ {likes}</span>
  </div>
  <div class="video-card__body">
    <h3 class="video-card__title">{video.title ?? '无标题'}</h3>
    <p class="video-card__author">
      {
        video.author_avatar_url && (
          <img
            class="video-card__author-avatar"
            src={video.author_avatar_url}
            alt={video.author_name ?? '作者头像'}
            loading="lazy"
            decoding="async"
            width="20"
            height="20"
          />
        )
      }
      <span>作者 · {video.author_name ?? '未知'}</span>
    </p>
  </div>
</a>
