---
// dating-nav 站点布局：委托共享 SiteLayout，注入本站的品牌 / 导航 / 页脚 / 主题。
import SiteLayout from '@creator-nav/ui/layouts/SiteLayout.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string | null;
  ogType?: string;
}

const { title, description, path, ogImage, ogType } = Astro.props;

// 主导航：首页 + 相亲信息聚合 + 热门地区快捷入口（同时贡献内链权重）
const NAV_ITEMS = [
  { label: '首页', href: '/' },
  { label: '相亲信息', href: '/dating' },
  { label: '月老连线', href: '/moon' },
  { label: '杭州', href: '/dating/hangzhou' },
  { label: '上海', href: '/dating/shanghai' },
  { label: '北京', href: '/dating/beijing' },
  { label: '深圳', href: '/dating/shenzhen' },
];

const FOOTER_LINKS = [
  { label: '关于我们', href: '/about' },
  { label: '隐私政策', href: '/privacy' },
  { label: '服务条款', href: '/terms' },
  { label: '版权与侵权', href: '/copyright' },
  { label: '联系我们', href: '/contact' },
];
const year = new Date().getFullYear();
---

<SiteLayout
  title={title}
  description={description}
  path={path}
  ogImage={ogImage}
  ogType={ogType}
  theme="dating"
  siteName="相亲导航"
  brandMark="💞"
  brandName="相亲"
  brandAccent="导航"
  navItems={NAV_ITEMS}
  footerLinks={FOOTER_LINKS}
  footerText={`© ${year} 相亲导航 · 发现公开相亲信息，判断近期相亲意愿，跳转原平台沟通`}
>
  <slot />
</SiteLayout>
